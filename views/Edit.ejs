<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
    <style>
        body{
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .btn{
            margin-left: 60px;
        }
    </style>
</head>
<body>
    <h2> You are going to edit the Username : <%= user.email %></h2>
    <form method="POST" action="/users/<%= user.Id %>?_method=PATCH" </form>>
        <textarea name="username"> <%= user.username %></textarea> <br><br>
        <input type="password" name="password" placeholder="Enter Your Password"/> <br><br>
        <button class="btn"> Edit </button>
    </form>
</body>
</html>
